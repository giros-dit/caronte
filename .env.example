SERVER_NAME="Wake on LAN Server"    # Server name to be displayed in the UI
SERVER_URL=  # Full URL to the server, including protocol and port (e.g., http://localhost:3000)
MAIL_FROM="Wake on LAN <noreply.wol@example.com>"   # Automated email sender address
MAIL_SERVER= # SMTP server address (e.g., smtp.example.com)
MAIL_PORT=    # 465 for SSL, 587 for TLS
MAIL_USE_TLS=  # Enable TLS (True/False)
MAIL_USER=  # (Optional) Username for SMTP authentication
MAIL_PASS=  # (Optional) Password for SMTP authentication

SECRET= # Random session secret string. You can generate one using `openssl rand -hex 32`. If not provided, a random secret will be generated at runtime, which will invalidate all existing sessions on server restart.
SESSION_COOKIE_SECURE = True
SESSION_COOKIE_HTTPONLY = True

SESSION_COOKIE_SAMESITE = 'Lax'

OIDC_ENABLED=False  # Enable OIDC authentication (True/False)
OIDC_SCOPES="openid email profile"  # OIDC client scopes (space-separated)
OIDC_CLIENT_SECRETS="./data/client_secrets.json"    # Path to the OIDC client secrets JSON file. Check README for example.
OIDC_PATH_PREFIX="/oidc"  # (Optional) Path prefix for OIDC endpoints (e.g., /oidc). If empty, it will override default login endpoint and allow only OIDC login.
OIDC_OVERWRITE_REDIRECT_URI="http://localhost:3000/oidc/authorize"  # (Optional) Overwrite the redirect URI for OIDC authorization. If not provided, the redirect URI will be constructed from SERVER_URL.
OIDC_ADMIN_GROUPS=""  # (Optional) Space-separated list of OIDC groups that will be granted admin privileges on login.
